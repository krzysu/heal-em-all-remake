{
  "name": "heal-em-all-remake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "description": "Heal'em All remastered on Phaser 4 + TypeScript + Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src vite.config.ts",
    "lint:fix": "oxlint --fix src vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint --deny-warnings && pnpm format:check && pnpm test && pnpm knip"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "jsdom": "^30.0.1",
    "knip": "^6.36.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
